{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "the-last-known-podcast",
	"main": "src/index.js",
	"compatibility_date": "2026-06-03",
	"vars": {
		"ADMIN_USERNAME": "admin",
		"SPREAKER_CLIENT_ID": "43320"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "EPISODE_CONTENT",
			"bucket_name": "the-last-known-podcast-content"
		},
		{
			"bucket_name": "the-last-known-podcast-content",
			"binding": "the_last_known_podcast_content",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "SITE_ANALYTICS",
			"database_name": "the-last-known-podcast-analytics",
			"database_id": "ca7c3787-6c6f-4244-9fbb-bd04361917c5",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
